# ============================================
# QuizUp - Variables de entorno de ejemplo
# Copia este archivo a .env.local y completa los valores.
# Las variables marcadas (opcional) pueden omitirse: se usa el default indicado.
# ============================================

# Conexión a MongoDB (necesaria para datos reales; debe coincidir con la del WebSocket)
MONGODB_URI=mongodb://localhost:27017/quizup

# Conexión de TEST (opcional): habilita las suites de contrato con Mongo real
# (p. ej. `node tools/test-with-mongo.mjs --repo QuizUp`). Usa SIEMPRE una base
# de test, nunca la de desarrollo.
# MONGODB_URI_TEST=mongodb://localhost:27017/quizup_test

# URL del servidor WebSocket (opcional; default http://localhost:4000)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Nivel de log (opcional; default info): debug | info | warn | error
LOG_LEVEL=info

# Unsplash - búsqueda de imágenes para las preguntas (opcional)
# 1. Crea una cuenta en https://unsplash.com/developers
# 2. Crea una app (New Application)
# 3. Copia el "Access Key" y pégalo aquí
# Sin esta clave, el buscador de imágenes mostrará un aviso, pero el resto funciona normal.
UNSPLASH_ACCESS_KEY=tu_access_key_de_unsplash