{
  // US-13 (test-engineer): el tsconfig raíz tiene `"jsx": "preserve"` (lo exige
  // Next.js). Vite 8/oxc respeta ese valor y deja el JSX sin transformar, por lo
  // que ningún test de Vitest puede importar componentes `.tsx`. Este tsconfig
  // anidado solo afecta a la resolución de Vite/Vitest para `components/` (no lo
  // usan Next ni `tsc --noEmit`, que leen el tsconfig raíz) y permite compilar
  // JSX en los tests de componentes. Alternativa para el builder: fijar
  // `esbuild: { jsx: "automatic" }` en `vitest.config.ts`.
  "compilerOptions": {
    "jsx": "react-jsx"
  }
}
